# Supabase → Project Settings → API. The anon key is safe in the browser; Row
# Level Security on the libraries table is what keeps one person's row from
# another. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Where magic links and OAuth send people back. Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only — used by /api/account to delete a person's auth user. Never
# prefix it NEXT_PUBLIC_. Leave it unset and account deletion reports itself
# as not configured rather than failing quietly.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Same key as the app (kodigo/Secrets.swift). Never NEXT_PUBLIC_.
TMDB_API_KEY=

# Stripe (web subscriptions). Server only, never NEXT_PUBLIC_. Leave them
# empty and the Pro page says web checkout isn't open yet; nothing charges.
# Dashboard → Developers → API keys: the secret key (sk_test_… while testing).
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → the endpoint for /api/stripe/webhook →
# Signing secret (whsec_…). Locally: `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=
# RevenueCat (Pro bought in the apps): the Authorization header value set on
# the webhook in RevenueCat (Integrations → Webhooks), and a v1 secret API key
# (Project settings → API keys) for reading a person's standing.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_KEY=
# Product catalogue → Kodigo Pro → the two prices' ids (price_…): $1.99 a
# month and $15.99 a year, USD, recurring.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Who can open /moderation: comma-separated sign-in emails. Everyone else
# gets a 404 there.
MODERATOR_EMAILS=

# Crash reports (Sentry). Leave empty and nothing is sent; the privacy
# policy's Crash reports section shows only when this is set.
# sentry.io → your project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: the organisation and project slugs,
# and an auth token (Settings → Auth Tokens) that can upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Ads (Google AdSense), for visitors and free accounts, never Pro. Leave
# empty and no ad or ad script loads; the privacy policy's Ads section and
# the footer's cookie settings link appear only when the client id is set.
# AdSense → Account → Account information → Publisher ID, as ca-pub-…
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense → Ads → By ad unit: one horizontal display unit per placement.
NEXT_PUBLIC_ADSENSE_SLOT_ROWS=
NEXT_PUBLIC_ADSENSE_SLOT_TITLE=
NEXT_PUBLIC_ADSENSE_SLOT_PROFILE=

# Development only: DEV_PRO=on lets a signed-in account use the Pro tracker
# (/calendar) without buying Pro, for testing. Ignored in a real build.
DEV_PRO=
