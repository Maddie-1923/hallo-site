# Supabase → Project Settings → API. The anon key is safe in the browser; Row
# Level Security on the libraries table is what keeps one person's row from
# another. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Where magic links and OAuth send people back. Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only — used by /api/account to delete a person's auth user. Never
# prefix it NEXT_PUBLIC_. Leave it unset and account deletion reports itself
# as not configured rather than failing quietly.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Same key as the app (kodigo/Secrets.swift). Never NEXT_PUBLIC_.
TMDB_API_KEY=
